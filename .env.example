# Copy this file to .env and fill in real values. Never commit .env itself.

# SMTP server that will send the mail (Gmail example below)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# The account that sends the email. For Gmail, SMTP_PASS must be a
# 16-character "App Password" (Google Account > Security > App passwords),
# NOT your normal Gmail password. Your Google account needs 2-Step
# Verification turned on to generate an app password.
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your16charapppassword

# Inbox that should receive contact form submissions.
# Defaults to SMTP_USER if not set.
TO_EMAIL=manojorg.23@gmail.com
